# CORS: origin Next.js dev server yang boleh manggil ai-service ini
# langsung dari browser (lihat web/app/imports/page.tsx). Pisahkan
# dengan koma kalau lebih dari satu. Default sudah mencakup localhost:3000.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dipakai services/receipt_extraction.py untuk baca foto/PDF struk lewat
# Gemini. Boleh pakai key yang sama dengan punya API/Phase1 - tapi nama
# variabelnya beda (di sana namanya PART8_GEMINI_API_KEY), jadi harus
# disalin ke sini pakai nama GEMINI_API_KEY, bukan cuma copy filenya.
# Tanpa kutip, tanpa spasi di sekitar tanda "=".
GEMINI_API_KEY=isi-dengan-key-gemini-kamu

# Opsional: kalau punya lebih dari satu key (round-robin, biar tidak
# kena rate-limit satu key), pisahkan dengan koma. Boleh isi salah satu
# saja (GEMINI_API_KEY atau GEMINI_API_KEYS), tidak perlu dua-duanya.
# GEMINI_API_KEYS=key-pertama,key-kedua
